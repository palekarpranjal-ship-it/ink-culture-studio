# Copy to .env.local for local development. In Vercel add the same names
# under Settings → Environment Variables (never commit real values).

# --- Site base URL (optional locally — code falls back to the production URL) ---
NEXT_PUBLIC_SITE_URL=https://www.streetculturetattoos.com

# --- Form spam protection (Cloudflare Turnstile) ---
# Create a widget at https://dash.cloudflare.com/turnstile
# Site key is public (client renders the widget); secret key stays server-only.
# Forms keep working until both are set, then CAPTCHA enforcement activates.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Ink Lab AI (server-side only, used by src/app/api/ink-lab/route.ts) ---
# From https://platform.openai.com/api-keys — without it the Ink Lab returns
# a graceful 503 telling clients to WhatsApp the studio instead.
OPENAI_API_KEY=

# --- Convex (live visit/active-users badge + auth) ---
# NEXT_PUBLIC_CONVEX_URL: Convex dashboard → your deployment → Settings → URL & Deploy Key
NEXT_PUBLIC_CONVEX_URL=
# CONVEX_SITE_URL: set automatically by `npx convex dev` / deploy
CONVEX_SITE_URL=
# CONVEX_DEPLOYMENT: used by `npx convex dev`
CONVEX_DEPLOYMENT=

# --- vly.ai email OTP (optional login integration) ---
VLY_INTEGRATION_KEY=
VLY_INTEGRATION_BASE_URL=https://integrations.vly.ai
