# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# --- Form spam protection (Cloudflare Turnstile) ---
# Create a Turnstile widget at https://dash.cloudflare.com/turnstile
# Site key is public (client renders the widget); secret key stays server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Ink Lab AI (server-side only, used by src/app/api/ink-lab/route.ts) ---
OPENAI_API_KEY=

# Convex client URL — enables the live visit/active-users badge (printed by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=
